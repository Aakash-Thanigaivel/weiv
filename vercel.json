{
  "images": {
    "sizes": [360, 480, 640, 960, 1024, 1536],
    "formats": ["image/webp"],
    "minimumCacheTTL": 86400
  },
  "rewrites": [
    {
      "source": "/((?!_vercel|assets|mobile|.*\\.(?:png|jpe?g|webp|svg|gif|ico|mp3|mp4|woff2?|ttf|eot)).*)",
      "destination": "/index.html"
    }
  ]
}
